<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately unsandboxed: the agent runs real git, package managers and shells in any folder. Hardened
	     runtime and notarization still apply; approvals, policy gates, tripwires and the audit chain are the
	     safety layer. See docs/11-CURRENT-STATE.md. -->
	<!-- Hardened runtime blocks the microphone unless it is declared; used only for dictation and voice conversations. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Location is requested only from the Maps activity and remains subject to macOS authorization. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Contacts are read (never written) for address lookup in Mail and by approved agents; still subject to macOS authorization. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<!-- Calendar and Reminders are read, and events and reminders are added only after approval; never edited or deleted. Still subject to macOS authorization. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Sending texts drives the Messages app with Apple Events, after the person allows it in Automation settings. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
